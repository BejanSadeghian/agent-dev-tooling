{
  "name": "dev-tooling-env",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Skill development environment: every use case is a doer/interpreter pair built to the agentskills.io layout, tested with accuracy/edge/performance suites, executed only by clean sub-agents, and shipped to the repos that use it.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash .framework/setup/install.sh",
    "status": "node .framework/scripts/dev.mjs status",
    "start": "node .framework/scripts/dev.mjs start",
    "sync": "node .framework/scripts/dev.mjs sync",
    "doctor": "node .framework/scripts/dev.mjs doctor",
    "lint": "node .framework/scripts/lint.mjs",
    "check": "node .framework/scripts/verify-all.mjs",
    "skill:new": "node .framework/scripts/new-skill.mjs",
    "test:new": "node .framework/scripts/gen-tests.mjs",
    "validate": "node .framework/scripts/validate-skill.mjs",
    "regression": "node .framework/scripts/run-regression.mjs",
    "python": "node .framework/scripts/run-python-tests.mjs",
    "rubric": "node .framework/scripts/check-rubric.mjs",
    "health": "node .framework/scripts/health.mjs",
    "subagent": "node .framework/scripts/subagent.mjs",
    "scenario": "node .framework/scripts/scenario.mjs",
    "publish": "node .framework/scripts/publish.mjs",
    "test": "node --test \".framework/tests/*.test.mjs\"",
    "verify": "npm run test && node .framework/scripts/verify-all.mjs",
    "ci": "npm run test && node .framework/scripts/lint.mjs && node .framework/scripts/validate-skill.mjs && node .framework/scripts/run-regression.mjs --no-record && node .framework/scripts/check-rubric.mjs && node .framework/scripts/health.mjs"
  },
  "license": "MIT"
}
