#!/usr/bin/env bash
# Warnings, never a gate: every skill touched by this commit is checked against the
# framework spec (.framework/FRAMEWORK.md) — including "its regression suite was run
# after this edit" — and failures are reported loudly, but the commit always
# proceeds. The human decides; the checks advise. Wire it up once with:
# bash .framework/scripts/setup-hooks.sh
set -uo pipefail # no -e: a failing check must never block the commit

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [[ "${SKIP_SKILL_GATE:-}" == "1" ]]; then
  echo "pre-commit: SKILL_GATE skipped (SKIP_SKILL_GATE=1)"
  exit 0
fi

# The staged file list — overridable so CI can run these same checks over a
# push/PR diff (see .github/workflows/skills-ci.yml, job "hook-parity").
STAGED="${SKILL_GATE_FILES:-$(git diff --cached --name-only --diff-filter=ACMR)}"
[[ -z "$STAGED" ]] && { echo "pre-commit: nothing staged"; exit 0; }

# Which skills does this commit touch? (no mapfile: macOS ships bash 3.2)
SKILLS=()
while IFS= read -r line; do
  [[ -n "$line" ]] && SKILLS+=("$line")
done < <(node .framework/scripts/changed-skills.mjs <<<"$STAGED")

WARN=0

# Tooling changed? Run the tooling's own tests. (.framework/state/ is test
# evidence written by the runner, not tooling — it changes on every skill edit.)
if grep -E '^(\.framework/|package\.json$)' <<<"$STAGED" | grep -qvE '^\.framework/state/'; then
  echo "pre-commit: tooling changed → lint + node --test .framework/tests/"
  node .framework/scripts/lint.mjs || WARN=1
  node --test ".framework/tests/*.test.mjs" || WARN=1
fi

if [[ ${#SKILLS[@]} -eq 0 ]]; then
  echo "pre-commit: no skills touched"
  exit 0
fi

echo "pre-commit: checking ${#SKILLS[@]} skill(s): ${SKILLS[*]}"

# 1. Format — layout, frontmatter, body, and the doer/observer role rules.
node .framework/scripts/validate-skill.mjs "${SKILLS[@]}" || WARN=1

# 2. Suite actually green right now (verify only — recording here would defeat the freshness rule).
node .framework/scripts/run-regression.mjs --no-record "${SKILLS[@]}" || WARN=1

# 3. Rubric — includes R5: the recorded run must post-date the latest edit.
node .framework/scripts/check-rubric.mjs "${SKILLS[@]}" || WARN=1

# 4. The refreshed state file should be part of THIS commit, not left dirty in the tree.
for skill in "${SKILLS[@]}"; do
  state=".framework/state/${skill}.json"
  [[ -f "$state" ]] || continue
  if ! git diff --quiet -- "$state"; then
    echo "pre-commit: warning: $state has unstaged changes — stage it with the skill change (git add $state)"
    WARN=1
  fi
done

if [[ $WARN -ne 0 ]]; then
  cat <<'MSG'

pre-commit: skill checks FAILED — committing anyway. Checks warn, never block.
  fix format    → see .framework/FRAMEWORK.md
  re-run suites → npm run regression -- <skill>   (then: git add .framework/state/<skill>.json)
  These same warnings appear in CI on every push and PR.
MSG
else
  echo "pre-commit: all skill checks passed"
fi

exit 0
