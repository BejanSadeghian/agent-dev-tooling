node_modules/
*.log
.DS_Store
tmp/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Skill outputs written while running a skill for real — never committed.
outputs/

# Captured sub-agent runs: transient evidence, judged then discarded.
evals/runs/

# Per-test trial evidence: the results.json summary is committed, but the bulky
# produced value on failure is not.
evals/tests/*/results/actual.json

# Reviewer list and ship targets are per-clone, not shared.
.framework/setup/reviewers.json
.framework/targets.json

# NOT ignored, on purpose: .framework/state/ is the evidence that each skill's tests
# were run after its last edit. It must be committed with the change.
